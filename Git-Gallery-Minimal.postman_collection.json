        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
              "if (pm.response.code === 202) { const data = pm.response.json(); pm.test(\"Capture count\", () => pm.expect(data.total_captures).to.eql(5)); pm.collectionVariables.set(\"last_job_id\", data.job_id); }"
            ]
          }
        }
      ]
    },
