              "if (pm.response.code === 202) { const data = pm.response.json(); pm.test(\"Capture count\", () => pm.expect(data.total_captures).to.eql(2)); pm.collectionVariables.set(\"last_job_id\", data.job_id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "09 — Reject eleven commits",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"{{repo_url}}\",\n  \"page_path\": \"index.html\",\n  \"commit_shas\": {{too_many_shas}}\n}",
          "options": {
